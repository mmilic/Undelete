#include "winuser.h"
1 ICON "resources/poslednja.ico"
1 RT_MANIFEST undelete.exe.manifest
#include "winver.h"
#include "version.h"

1 VERSIONINFO
FILEVERSION     APP_VERSION_MAJOR,APP_VERSION_MINOR,0,0
PRODUCTVERSION  APP_VERSION_MAJOR,APP_VERSION_MINOR,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "GetMyFilesBack - recover deleted files"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "UndeleteWizzard"
            VALUE "OriginalFilename", "GetMyFilesBack.exe"
            VALUE "ProductName", "GetMyFilesBack"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
